{
  "name": "parthik",
  "version": "0.1.0",
  "private": true,
  "description": "Parthik \u2014 hyperlocal commerce and delivery platform",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv ./types/cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "db:check": "drizzle-kit export --sql > /dev/null && echo \"Drizzle schema is valid (no migrations generated)\"",
    "db:export": "drizzle-kit export --sql",
    "og:generate": "tsx scripts/generate-og-images.mts",
    "seed": "tsx db/seed/index.ts",
    "seed:demo": "SEED_DEMO=1 tsx db/seed/index.ts",
    "test:e2e:ci": "bash scripts/run-e2e.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "firebase": "^12.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.548.0",
    "next": "^16.3.0",
    "next-intl": "^4.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.0",
    "@opennextjs/cloudflare": "^1.14.0",
    "@peculiar/x509": "^2.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0"
  }
}

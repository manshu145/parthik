###############################################################################
# Parthik — environment template
#
# Copy to .env.local for local development:   cp .env.example .env.local
#
# RULES
#   - NEVER commit a real .env file. Only this template is tracked.
#   - Secrets live in Cloudflare Worker secrets (production) and GitHub Actions
#     secrets (CI). See docs/SECURITY.md §9.1.
#   - Only NEXT_PUBLIC_* values reach the browser; they must contain nothing
#     sensitive.
#
# The application BOOTS WITHOUT any of the optional values below. Unconfigured
# providers report themselves at /api/v1/health/deep and raise a typed
# ConfigurationError only if something tries to use them.
###############################################################################

# ---------------------------------------------------------------------------
# Core (required — sensible defaults exist for local development)
# ---------------------------------------------------------------------------
# development | preview | staging | production
APP_ENV=development
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL (D-01, D-02).  Needed from TASK 002.
# ---------------------------------------------------------------------------
# Local development, CI and migrations connect directly.
# In production the Workers runtime uses the HYPERDRIVE binding instead
# (configured in wrangler.jsonc, not here).
# DATABASE_URL=postgresql://parthik:parthik@localhost:5432/parthik

# ---------------------------------------------------------------------------
# Cache — Redis-compatible over HTTP (D-03).  Needed from TASK 003.
# Workers cannot open arbitrary TCP connections, so the cache must expose REST.
# ---------------------------------------------------------------------------
# CACHE_REST_URL=https://example.upstash.io
# CACHE_REST_TOKEN=

# ---------------------------------------------------------------------------
# Firebase — client (D-08).  Public by design: Firebase security comes from
# server-side token verification, not from hiding these values.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=parthik.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=parthik
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Web Push public key for FCM (D-26).
# NEXT_PUBLIC_FCM_VAPID_KEY=

# ---------------------------------------------------------------------------
# Firebase — server (D-08, D-36).
#
# ⚠️  FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY is the MOST SENSITIVE secret in the
#     system: it can act on any user account. Minimum IAM roles, never logged,
#     rotated on schedule, use monitored via Cloud Audit Logs.
#
# Only FIREBASE_PROJECT_ID is needed to VERIFY ID tokens. The service account is
# required only for privileged Identity Platform REST calls and FCM sends.
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=parthik
# FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@parthik.iam.gserviceaccount.com
# Keep the quotes; \n escapes are converted to real newlines automatically.
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Set ONLY for tests/CI against the Firebase Auth Emulator (docs/ARCHITECTURE.md
# §13.1). Emulator tokens are unsigned, so this is rejected outright when
# APP_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------------------
# Google Maps Platform (D-23).  Needed from TASK 005.
# TWO SEPARATE KEYS with different restrictions — do not reuse one for both.
# ---------------------------------------------------------------------------
# Browser key: HTTP-referrer restricted, Maps JavaScript display only.
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server key: IP restricted, allows Places / Geocoding / Routes / Route Matrix.
# GOOGLE_MAPS_SERVER_KEY=

# Provider selection. LEAVE THIS UNSET for local development.
#
#   auto   (default) Google when GOOGLE_MAPS_SERVER_KEY is set, otherwise the
#                    deterministic mock provider. A fresh clone therefore works
#                    with no credentials at all.
#   google           Always Google. Fails with a 503 if the key is missing.
#   mock             Always the mock provider.
#
# `auto` NEVER resolves to the mock when APP_ENV=production: a missing key there
# fails loudly rather than serving fabricated addresses and delivery fees.
# See .kiro/steering/provider-credentials.md.
# MAPS_PROVIDER=auto

# ---------------------------------------------------------------------------
# Analytics — Firebase Analytics + GA4 (D-28).
# GA4 is NOT the source of business truth; admin KPIs come from PostgreSQL.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Server-side Measurement Protocol secret, for commercial events.
# GA4_API_SECRET=

# ---------------------------------------------------------------------------
# Google Cloud Logging / Monitoring (D-27).
# Optional: without it, structured logs still go to stdout and are collected by
# Workers observability.
# ---------------------------------------------------------------------------
# GCP_PROJECT_ID=parthik
# GCP_LOG_NAME=parthik

###############################################################################
# NOT USED YET — documented so the shape is known, added by their own task.
#
#   Razorpay (D-13, TASK 011)
#     RAZORPAY_KEY_ID=
#     RAZORPAY_KEY_SECRET=
#     RAZORPAY_WEBHOOK_SECRET=
#
#   Cloudflare R2 (D-07)         — bound in wrangler.jsonc, not via env
#
# Public base URL for stored images (the R2 public bucket or its custom domain).
# Leave UNSET until decision D-07a picks an image loader: with no value, product
# and category images resolve to null and the UI shows a neutral placeholder
# rather than a guessed, broken URL.
# NEXT_PUBLIC_ASSET_BASE_URL=https://assets.example.com
#   Cloudflare Turnstile (D-35)  — TURNSTILE_SECRET / NEXT_PUBLIC_TURNSTILE_SITE_KEY
#   reCAPTCHA for Firebase Phone Auth (D-35)
#     NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
#
# BLOCKED — no variables exist for these by decision:
#   Transactional email (D-25)   — no Google-native provider
#   Non-OTP SMS (D-34)           — Firebase covers OTP only
###############################################################################
